# ============================================================
# TERIMA JASA - ENVIRONMENT CONFIGURATION
# ============================================================

APP_NAME="Terima Jasa"
APP_ENV=development
APP_DEBUG=true

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=terima_jasa_db
DB_USERNAME=root
DB_PASSWORD=

# AI Assistant Service Configuration
# Provider options: 'groq', 'openai', 'gemini', 'custom'
AI_PROVIDER=groq
AI_API_KEY=your_api_key_here
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_FALLBACK_MODE=1
AI_CONFIG_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# WhatsApp Gateway & OTP Authentication Configuration
# Provider: 'fonnte', 'meta', or 'mock' (default mock in dev if token is empty)
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_TOKEN=your_whatsapp_token_here
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_SENDER_ID=
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
